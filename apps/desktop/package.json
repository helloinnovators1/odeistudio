{
  "name": "@odei/studio-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native ODEI Studio desktop host for Windows, macOS and Linux",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "45.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.odei.studio",
    "productName": "ODEI Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "security.cjs",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
