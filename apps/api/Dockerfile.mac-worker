FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/odei

COPY pyproject.toml ./
COPY odei_api ./odei_api

RUN python -m pip install --no-cache-dir .

# The worker has no shell requirement and must not run as root.
RUN groupadd --system --gid 10001 odei \
    && useradd --system --uid 10001 --gid odei --home-dir /nonexistent \
       --shell /usr/sbin/nologin odei

USER 10001:10001
STOPSIGNAL SIGTERM

ENTRYPOINT ["odei-mac-deployment-worker"]
