# Copy to .env for local development. Never commit populated .env files.
ENVIRONMENT=development
APP_NAME=ODEI Studio API
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Configure these only in your private local environment or secret manager.
OPENAI_API_KEY=
ODEI_MODEL=

# Use the Atlas-provided URI; keep the real value private.
MONGODB_URI=
MONGODB_DATABASE=odei_studio

# OIDC / ODEI Identity trust configuration. Leave unset until a trusted issuer is selected.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
