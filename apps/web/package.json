    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "@playwright/test": "1.65.1"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  }
